@@ -0,0 +1,48 @@
+/*
+ * Private ioctls between winusb.dll and wineusb.sys
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#ifndef __WINE_WINEUSB_IOCTL_H
+#define __WINE_WINEUSB_IOCTL_H
+
+#include "winioctl.h"
+
+#ifndef FILE_DEVICE_USB
+#define FILE_DEVICE_USB FILE_DEVICE_UNKNOWN
+#endif
+
+/* Returns the bInterfaceNumber the file refers to as a ULONG, or ~0u for a whole device. */
+#define IOCTL_WINEUSB_GET_INTERFACE     CTL_CODE(FILE_DEVICE_USB, 0x7f0, METHOD_BUFFERED, FILE_ANY_ACCESS)
+/* Input: struct wineusb_setup_packet, followed by the data of an OUT transfer.
+ * Output: the data of an IN transfer. */
+#define IOCTL_WINEUSB_CONTROL_TRANSFER  CTL_CODE(FILE_DEVICE_USB, 0x7f1, METHOD_BUFFERED, FILE_ANY_ACCESS)
+/* Input: struct wineusb_pipe. Output: the data read. */
+#define IOCTL_WINEUSB_READ_PIPE         CTL_CODE(FILE_DEVICE_USB, 0x7f2, METHOD_BUFFERED, FILE_ANY_ACCESS)
+/* Input: struct wineusb_pipe, followed by the data to write. */
+#define IOCTL_WINEUSB_WRITE_PIPE        CTL_CODE(FILE_DEVICE_USB, 0x7f3, METHOD_BUFFERED, FILE_ANY_ACCESS)
+/* Input: struct wineusb_pipe. */
+#define IOCTL_WINEUSB_RESET_PIPE        CTL_CODE(FILE_DEVICE_USB, 0x7f4, METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define IOCTL_WINEUSB_ABORT_PIPE        CTL_CODE(FILE_DEVICE_USB, 0x7f5, METHOD_BUFFERED, FILE_ANY_ACCESS)
+
+struct wineusb_setup_packet
+{
+    UCHAR RequestType;
+    UCHAR Request;
+    USHORT Value;
+    USHORT Index;
+    USHORT Length;
+};
+
+struct wineusb_pipe
+{
+    UCHAR endpoint;
+    UCHAR type; /* USBD_PIPE_TYPE */
+    UCHAR padding[6];
+};
+
+#endif /* __WINE_WINEUSB_IOCTL_H */
