 }
 
+static void set_device_address(struct usb_device *device)
+{
+    struct string_buffer id = {0}, instance = {0};
+    UNICODE_STRING string;
+    OBJECT_ATTRIBUTES attr;
+    WCHAR path[MAX_PATH];
+    HANDLE key;
+
+    get_device_id(device, &id);
+    get_instance_id(device, &instance);
+    if (id.string && instance.string)
+    {
+        swprintf(path, ARRAY_SIZE(path), L"\\Registry\\Machine\\System\\CurrentControlSet\\Enum\\%s\\%s",
+                id.string, instance.string);
+        RtlInitUnicodeString(&string, path);
+        InitializeObjectAttributes(&attr, &string, OBJ_CASE_INSENSITIVE, NULL, NULL);
+        if (!ZwOpenKey(&key, KEY_SET_VALUE, &attr))
+        {
+            RtlInitUnicodeString(&string, L"Address");
+            NtSetValueKey(key, &string, 0, REG_DWORD, &device->hub_port, sizeof(device->hub_port));
+            ZwClose(key);
+        }
+        else
+            WARN("Failed to open %s.\n", debugstr_w(path));
+    }
+    if (id.string) ExFreePool(id.string);
+    if (instance.string) ExFreePool(instance.string);
+}
+
+/* Register the interfaces a WinUSB inf declares in the device's
+ * "Device Parameters" key, as winusb.sys does on Windows. */
+static void register_extra_interfaces(struct usb_device *device)
+{
+    static const WCHAR *names[] = {L"DeviceInterfaceGUIDs", L"DeviceInterfaceGUID"};
+    KEY_VALUE_PARTIAL_INFORMATION *info;
+    UNICODE_STRING string, guid_string;
+    unsigned int i, count = 0;
+    ULONG size = 1024;
+    const WCHAR *p;
+    HANDLE key;
+    GUID guid;
+
+    if (IoOpenDeviceRegistryKey(device->device_obj, PLUGPLAY_REGKEY_DEVICE, KEY_QUERY_VALUE, &key))
+        return;
+    if (!(info = ExAllocatePool(PagedPool, size)))
+    {
+        ZwClose(key);
+        return;
+    }
+
+    for (i = 0; i < ARRAY_SIZE(names); ++i)
+    {
+        RtlInitUnicodeString(&string, names[i]);
+        if (ZwQueryValueKey(key, &string, KeyValuePartialInformation, info, size - 2 * sizeof(WCHAR), &size)
+                || (info->Type != REG_MULTI_SZ && info->Type != REG_SZ))
+        {
+            size = 1024;
+            continue;
+        }
+        info->Data[info->DataLength] = info->Data[info->DataLength + 1] = 0;
+        info->Data[info->DataLength + 2] = info->Data[info->DataLength + 3] = 0;
+        for (p = (const WCHAR *)info->Data; *p && count < ARRAY_SIZE(device->extra_links); p += wcslen(p) + 1)
+        {
+            RtlInitUnicodeString(&guid_string, p);
+            if (RtlGUIDFromString(&guid_string, &guid))
+                continue;
+            TRACE("Registering interface %s.\n", debugstr_guid(&guid));
+            if (!IoRegisterDeviceInterface(device->device_obj, &guid, NULL, &device->extra_links[count]))
+                IoSetDeviceInterfaceState(&device->extra_links[count++], TRUE);
+        }
+        break;
+    }
+
+    ExFreePool(info);
+    ZwClose(key);
+}
