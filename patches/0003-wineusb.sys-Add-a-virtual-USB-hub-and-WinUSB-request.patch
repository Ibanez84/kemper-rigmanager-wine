From 77a5a3c0b99ee8b8ad3da5287a3df57ed398585f Mon Sep 17 00:00:00 2001
From: Ibanez84 <359704787+Ibanez84@users.noreply.github.com>
Date: Sun, 22 Nov 2026 01:07:47 +0000
Subject: [PATCH 3/5] wineusb.sys: Add a virtual USB hub and WinUSB request
 support.

- Register GUID_DEVINTERFACE_USB_HUB on the root device and answer
  IOCTL_USB_GET_NODE_CONNECTION_INFORMATION(_EX) and
  IOCTL_USB_GET_DESCRIPTOR_FROM_NODE_CONNECTION, giving each device its own port address.
- Register GUID_DEVINTERFACE_USB_DEVICE and the DeviceInterfaceGUIDs from the device's
  "Device Parameters" key, as installed by a WinUSB INF.
- Add private IOCTLs (include/wine/wineusb_ioctl.h) for control, bulk/interrupt read and write,
  reset pipe and abort pipe, used by winusb.dll. Requests complete asynchronously, and closing
  a handle cancels its pending transfers.
---
 dlls/wineusb.sys/wineusb.c   | 520 ++++++++++++++++++++++++++++++++++-
 include/Makefile.in          |   1 +
 include/wine/wineusb_ioctl.h |  48 ++++
 3 files changed, 568 insertions(+), 1 deletion(-)
 create mode 100644 include/wine/wineusb_ioctl.h

diff --git a/dlls/wineusb.sys/wineusb.c b/dlls/wineusb.sys/wineusb.c
index 4d86fb1..a048983 100644
--- a/dlls/wineusb.sys/wineusb.c
+++ b/dlls/wineusb.sys/wineusb.c
@@ -35,11 +35,50 @@
 #include "wine/asm.h"
 #include "wine/debug.h"
 #include "wine/list.h"
+#include "wine/wineusb_ioctl.h"
 
 #include "unixlib.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(wineusb);
 
+/* The bus FDO doubles as a USB hub, so that applications can query devices
+ * through the standard hub ioctls. Each non-interface device gets a port. */
+
+static const GUID GUID_DEVINTERFACE_USB_DEVICE = {0xa5dcbf10, 0x6530, 0x11d2, {0x90, 0x1f, 0x00, 0xc0, 0x4f, 0xb9, 0x51, 0xed}};
+static const GUID GUID_DEVINTERFACE_USB_HUB = {0xf18a0e88, 0xc30c, 0x11d0, {0x88, 0x15, 0x00, 0xa0, 0xc9, 0x06, 0xbe, 0xd8}};
+
+#define IOCTL_USB_GET_NODE_CONNECTION_INFORMATION       0x22040c
+#define IOCTL_USB_GET_DESCRIPTOR_FROM_NODE_CONNECTION   0x220410
+#define IOCTL_USB_GET_NODE_CONNECTION_INFORMATION_EX    0x220448
+
+#include "pshpack1.h"
+struct hub_connection_info
+{
+    ULONG ConnectionIndex;
+    USB_DEVICE_DESCRIPTOR DeviceDescriptor;
+    UCHAR CurrentConfigurationValue;
+    UCHAR Speed;
+    BOOLEAN DeviceIsHub;
+    USHORT DeviceAddress;
+    ULONG NumberOfOpenPipes;
+    ULONG ConnectionStatus;
+};
+
+struct hub_descriptor_request
+{
+    ULONG ConnectionIndex;
+    struct
+    {
+        UCHAR bmRequest;
+        UCHAR bRequest;
+        USHORT wValue;
+        USHORT wIndex;
+        USHORT wLength;
+    } SetupPacket;
+    UCHAR Data[1];
+};
+#include "poppack.h"
+
