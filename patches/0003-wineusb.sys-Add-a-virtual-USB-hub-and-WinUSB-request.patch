             IoDeleteDevice(device->device_obj);
@@ -655,6 +842,7 @@ static NTSTATUS WINAPI driver_internal_ioctl(DEVICE_OBJECT *device_obj, IRP *irp
     switch (code)
     {
         case IOCTL_INTERNAL_USB_SUBMIT_URB:
+            irp->Tail.Overlay.DriverContext[1] = NULL;
             status = usb_submit_urb(device, irp);
             break;
 
@@ -671,6 +859,332 @@ static NTSTATUS WINAPI driver_internal_ioctl(DEVICE_OBJECT *device_obj, IRP *irp
     return status;
 }
 
+static struct usb_device *get_hub_port_device(ULONG port)
+{
+    struct usb_device *device, *ret = NULL;
+
+    EnterCriticalSection(&wineusb_cs);
+    LIST_FOR_EACH_ENTRY(device, &device_list, struct usb_device, entry)
+    {
+        if (device->hub_port == port)
+        {
+            ret = device;
+            break;
+        }
+    }
+    LeaveCriticalSection(&wineusb_cs);
+    return ret;
+}
+
+static NTSTATUS get_descriptor(struct usb_device *device, UCHAR type, UCHAR index,
+        USHORT lang, void *buffer, ULONG *len)
+{
+    struct _URB_CONTROL_DESCRIPTOR_REQUEST *req;
+    IO_STATUS_BLOCK io;
+    NTSTATUS status;
+    KEVENT event;
+    URB urb;
+    IRP *irp;
+
+    memset(&urb, 0, sizeof(urb));
+    req = &urb.UrbControlDescriptorRequest;
+    req->Hdr.Length = sizeof(*req);
+    req->Hdr.Function = URB_FUNCTION_GET_DESCRIPTOR_FROM_DEVICE;
+    req->TransferBuffer = buffer;
+    req->TransferBufferLength = *len;
+    req->Index = index;
+    req->DescriptorType = type;
+    req->LanguageId = lang;
+
+    KeInitializeEvent(&event, NotificationEvent, FALSE);
+    if (!(irp = IoBuildDeviceIoControlRequest(IOCTL_INTERNAL_USB_SUBMIT_URB, device->device_obj,
+            NULL, 0, NULL, 0, TRUE, &event, &io)))
+        return STATUS_NO_MEMORY;
+    IoGetNextIrpStackLocation(irp)->Parameters.Others.Argument1 = &urb;
+
+    if ((status = IoCallDriver(device->device_obj, irp)) == STATUS_PENDING)
+    {
+        KeWaitForSingleObject(&event, Executive, KernelMode, FALSE, NULL);
+        status = io.Status;
+    }
+    *len = req->TransferBufferLength;
+    return status;
+}
+
+static NTSTATUS hub_ioctl(IRP *irp)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    ULONG code = stack->Parameters.DeviceIoControl.IoControlCode;
+    ULONG in_len = stack->Parameters.DeviceIoControl.InputBufferLength;
+    ULONG out_len = stack->Parameters.DeviceIoControl.OutputBufferLength;
+    void *buffer = irp->AssociatedIrp.SystemBuffer;
+    struct usb_device *device;
+    NTSTATUS status;
+
+    TRACE("code %#lx, in_len %lu, out_len %lu.\n", code, in_len, out_len);
+
+    switch (code)
+    {
+        case IOCTL_USB_GET_NODE_CONNECTION_INFORMATION:
+        case IOCTL_USB_GET_NODE_CONNECTION_INFORMATION_EX:
+        {
+            struct hub_connection_info *info = buffer;
+            ULONG port, len = sizeof(info->DeviceDescriptor);
+
+            if (in_len < sizeof(ULONG) || out_len < sizeof(*info))
+                return STATUS_BUFFER_TOO_SMALL;
+            port = info->ConnectionIndex;
+            memset(info, 0, sizeof(*info));
+            info->ConnectionIndex = port;
+            irp->IoStatus.Information = sizeof(*info);
+            if (!(device = get_hub_port_device(port)))
+                return STATUS_SUCCESS; /* NoDeviceConnected */
+
+            if ((status = get_descriptor(device, USB_DEVICE_DESCRIPTOR_TYPE, 0, 0, &info->DeviceDescriptor, &len)))
+                return status;
+            info->CurrentConfigurationValue = 1;
+            if (code == IOCTL_USB_GET_NODE_CONNECTION_INFORMATION_EX)
+                info->Speed = device->usbver >= 0x200 ? 2 : 1; /* UsbHighSpeed / UsbFullSpeed */
+            info->DeviceAddress = port;
+            info->ConnectionStatus = 1; /* DeviceConnected */
+            return STATUS_SUCCESS;
+        }
+
+        case IOCTL_USB_GET_DESCRIPTOR_FROM_NODE_CONNECTION:
+        {
+            struct hub_descriptor_request *req = buffer;
+            ULONG header = offsetof(struct hub_descriptor_request, Data), len;
+
+            if (in_len < header || out_len < header)
+                return STATUS_BUFFER_TOO_SMALL;
+            if (!(device = get_hub_port_device(req->ConnectionIndex)))
+                return STATUS_INVALID_PARAMETER;
+
+            len = min(req->SetupPacket.wLength, out_len - header);
+            if ((status = get_descriptor(device, req->SetupPacket.wValue >> 8, req->SetupPacket.wValue & 0xff,
+                    req->SetupPacket.wIndex, req->Data, &len)))
+                return status;
+            irp->IoStatus.Information = header + len;
+            return STATUS_SUCCESS;
+        }
+    }
+
+    FIXME("Unhandled hub ioctl %#lx.\n", code);
+    return STATUS_NOT_SUPPORTED;
+}
+
+static HANDLE make_pipe_handle(UCHAR endpoint, UCHAR type)
+{
+    /* must match the encoding in unixlib.c */
+    union
+    {
+        struct { unsigned char endpoint, type; } pipe;
+        HANDLE handle;
+    } u = {{0}};
+
+    u.pipe.endpoint = endpoint;
+    u.pipe.type = type;
+    return u.handle;
+}
+
+static NTSTATUS submit_user_urb(struct usb_device *device, IRP *irp, URB *urb)
+{
+    NTSTATUS status;
+
+    IoGetCurrentIrpStackLocation(irp)->Parameters.Others.Argument1 = urb;
+    irp->Tail.Overlay.DriverContext[1] = urb;
+    if ((status = usb_submit_urb(device, irp)) != STATUS_PENDING)
+    {
+        irp->Tail.Overlay.DriverContext[1] = NULL;
+        ExFreePool(urb);
+    }
+    return status;
+}
+
+static NTSTATUS pdo_ioctl(struct usb_device *device, IRP *irp)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    ULONG code = stack->Parameters.DeviceIoControl.IoControlCode;
+    ULONG in_len = stack->Parameters.DeviceIoControl.InputBufferLength;
+    ULONG out_len = stack->Parameters.DeviceIoControl.OutputBufferLength;
+    UCHAR *buffer = irp->AssociatedIrp.SystemBuffer;
+    URB *urb;
+
+    TRACE("device %p, code %#lx, in_len %lu, out_len %lu.\n", device, code, in_len, out_len);
+
+    switch (code)
+    {
+        case IOCTL_WINEUSB_GET_INTERFACE:
+            if (out_len < sizeof(ULONG))
+                return STATUS_BUFFER_TOO_SMALL;
+            *(ULONG *)buffer = device->interface ? device->interface_index : ~0u;
+            irp->IoStatus.Information = sizeof(ULONG);
+            return STATUS_SUCCESS;
+
+        case IOCTL_WINEUSB_CONTROL_TRANSFER:
+        {
+            struct wineusb_setup_packet setup;
+            UCHAR type, recipient;
+            BOOL in;
+            void *data;
+
+            if (in_len < sizeof(setup))
+                return STATUS_INVALID_PARAMETER;
+            memcpy(&setup, buffer, sizeof(setup));
+            in = !!(setup.RequestType & 0x80);
+            type = (setup.RequestType >> 5) & 3;
+            recipient = setup.RequestType & 0x1f;
+            if (in ? out_len < setup.Length : in_len - sizeof(setup) < setup.Length)
+                return STATUS_INVALID_PARAMETER;
+            data = in ? buffer : buffer + sizeof(setup);
+
+            if (!(urb = ExAllocatePool(NonPagedPool, sizeof(*urb))))
+                return STATUS_NO_MEMORY;
+            memset(urb, 0, sizeof(*urb));
+
+            if (type == 0 && in && recipient == 0 && setup.Request == 6 /* GET_DESCRIPTOR */)
+            {
+                struct _URB_CONTROL_DESCRIPTOR_REQUEST *req = &urb->UrbControlDescriptorRequest;
+
+                req->Hdr.Length = sizeof(*req);
+                req->Hdr.Function = URB_FUNCTION_GET_DESCRIPTOR_FROM_DEVICE;
+                req->TransferBuffer = data;
+                req->TransferBufferLength = setup.Length;
+                req->DescriptorType = setup.Value >> 8;
+                req->Index = setup.Value & 0xff;
+                req->LanguageId = setup.Index;
+            }
+            else if (type == 2 && recipient <= 2)
+            {
+                static const USHORT functions[] =
+                        {URB_FUNCTION_VENDOR_DEVICE, URB_FUNCTION_VENDOR_INTERFACE, URB_FUNCTION_VENDOR_ENDPOINT};
+                struct _URB_CONTROL_VENDOR_OR_CLASS_REQUEST *req = &urb->UrbControlVendorClassRequest;
+
+                req->Hdr.Length = sizeof(*req);
+                req->Hdr.Function = functions[recipient];
+                req->TransferFlags = in ? USBD_TRANSFER_DIRECTION_IN | USBD_SHORT_TRANSFER_OK : 0;
+                req->TransferBuffer = data;
+                req->TransferBufferLength = setup.Length;
+                req->Request = setup.Request;
+                req->Value = setup.Value;
+                req->Index = setup.Index;
+            }
+            else
+            {
+                FIXME("Unsupported control request type %#x, request %#x.\n", setup.RequestType, setup.Request);
+                ExFreePool(urb);
+                return STATUS_NOT_SUPPORTED;
+            }
+            return submit_user_urb(device, irp, urb);
+        }
+
+        case IOCTL_WINEUSB_READ_PIPE:
+        case IOCTL_WINEUSB_WRITE_PIPE:
+        case IOCTL_WINEUSB_RESET_PIPE:
+        case IOCTL_WINEUSB_ABORT_PIPE:
+        {
+            struct wineusb_pipe pipe;
+
+            if (in_len < sizeof(pipe))
+                return STATUS_INVALID_PARAMETER;
+            memcpy(&pipe, buffer, sizeof(pipe));
+
+            if (!(urb = ExAllocatePool(NonPagedPool, sizeof(*urb))))
+                return STATUS_NO_MEMORY;
+            memset(urb, 0, sizeof(*urb));
+
+            if (code == IOCTL_WINEUSB_RESET_PIPE || code == IOCTL_WINEUSB_ABORT_PIPE)
+            {
+                urb->UrbPipeRequest.Hdr.Length = sizeof(urb->UrbPipeRequest);
+                urb->UrbPipeRequest.Hdr.Function = code == IOCTL_WINEUSB_RESET_PIPE
+                        ? URB_FUNCTION_SYNC_RESET_PIPE_AND_CLEAR_STALL : URB_FUNCTION_ABORT_PIPE;
+                urb->UrbPipeRequest.PipeHandle = make_pipe_handle(pipe.endpoint, pipe.type);
+            }
+            else
+            {
+                struct _URB_BULK_OR_INTERRUPT_TRANSFER *req = &urb->UrbBulkOrInterruptTransfer;
+
+                req->Hdr.Length = sizeof(*req);
+                req->Hdr.Function = URB_FUNCTION_BULK_OR_INTERRUPT_TRANSFER;
+                req->PipeHandle = make_pipe_handle(pipe.endpoint, pipe.type);
+                if (code == IOCTL_WINEUSB_READ_PIPE)
+                {
+                    req->TransferFlags = USBD_TRANSFER_DIRECTION_IN | USBD_SHORT_TRANSFER_OK;
+                    req->TransferBuffer = buffer;
+                    req->TransferBufferLength = out_len;
+                }
+                else
+                {
+                    req->TransferBuffer = buffer + sizeof(pipe);
+                    req->TransferBufferLength = in_len - sizeof(pipe);
+                }
+            }
+            return submit_user_urb(device, irp, urb);
+        }
+    }
+
+    FIXME("Unhandled ioctl %#lx.\n", code);
+    return STATUS_NOT_SUPPORTED;
+}
+
+/* Cancel the transfers a closing handle still has pending. */
+static void cancel_file_transfers(struct usb_device *device, FILE_OBJECT *file)
+{
+    LIST_ENTRY *entry;
+
+    EnterCriticalSection(&wineusb_cs);
+    for (entry = device->irp_list.Flink; entry != &device->irp_list; entry = entry->Flink)
+    {
+        IRP *queued_irp = CONTAINING_RECORD(entry, IRP, Tail.Overlay.ListEntry);
+        struct usb_cancel_transfer_params params =
+        {
+            .transfer = queued_irp->Tail.Overlay.DriverContext[0],
+        };
+
+        if (queued_irp->Tail.Overlay.DriverContext[1] && IoGetCurrentIrpStackLocation(queued_irp)->FileObject == file)
+            WINE_UNIX_CALL(unix_usb_cancel_transfer, &params);
+    }
+    LeaveCriticalSection(&wineusb_cs);
+}
+
+static NTSTATUS WINAPI driver_create_close(DEVICE_OBJECT *device_obj, IRP *irp)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+
+    if (device_obj != bus_fdo && stack->MajorFunction == IRP_MJ_CLEANUP)
+        cancel_file_transfers(device_obj->DeviceExtension, stack->FileObject);
+
+    irp->IoStatus.Status = STATUS_SUCCESS;
+    IoCompleteRequest(irp, IO_NO_INCREMENT);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS WINAPI driver_ioctl(DEVICE_OBJECT *device_obj, IRP *irp)
+{
+    NTSTATUS status;
+
+    if (device_obj == bus_fdo)
+        status = hub_ioctl(irp);
+    else
+    {
+        struct usb_device *device = device_obj->DeviceExtension;
+        BOOL removed;
+
+        EnterCriticalSection(&wineusb_cs);
+        removed = device->removed;
+        LeaveCriticalSection(&wineusb_cs);
+
+        status = removed ? STATUS_DELETE_PENDING : pdo_ioctl(device, irp);
+    }
+
+    if (status != STATUS_PENDING)
+    {
+        irp->IoStatus.Status = status;
+        IoCompleteRequest(irp, IO_NO_INCREMENT);
+    }
+    return status;
+}
